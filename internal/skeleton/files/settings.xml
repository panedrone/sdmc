<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="settings.xsd">

    <!-- Paths are relative to the project root (the folder of go.mod).
         The generated code is the data layer of the application: keep it under internal/. -->

    <!-- target: "module" from go.mod; sql: base folder of SQL files -->

    <folders target="{{module}}" sql="{{sql}}"/>

    <!-- scope: folder of generated models

         field-names-mode: the IDE plug-in only; sdmc ignores it. The names always follow
            the Go conventions: TitleCase fields (task_id -> TaskID), camelCase parameters (taskID). -->

    <dto scope="{{dto}}" inheritance="" field-names-mode="0" macro=""/>

    <!-- scope: folder of generated DAO files

         field-assign-mode:
            0 - by column name (database/sql, gorm)
            1 - by field position (unsafe)
            2 - ptr to DTO or ptr to slice of DTO-s (gorm, sqlx)
            3 - ptr to resulting slice of DTO-s (gorm, sqlx) -->

    <dao scope="{{dao}}" field-assign-mode="{{assign}}" macro=""/>

    <ide event-log="true"/>

    <!-- One "settings.xml" for the IDE plug-in and for sdmc:
            jdbc  - the IDE plug-in (jar, class and url of JDBC); sdmc does not read it.
            db    - sdmc (url: postgres://host:port/db, mysql://host:port/db or sqlite:<file>);
                    the IDE plug-in ignores it. SDM_PWD, if set, overrides "pwd" of db. -->

    <jdbc jar="{{jdbc-jar}}" class="{{jdbc-class}}"
          url="{{jdbc-url}}" user="{{user}}" pwd=""/>

    <db url="{{url}}" user="{{user}}" pwd=""/>

    <!-- detected: the type of a column as the driver names it. The keys below are {{db}}
         (sdmc init -db pg, mysql or sqlite). PostgreSQL says int4, varchar, timestamptz, ...;
         MySQL says INT, VARCHAR, DATETIME, UNSIGNED BIGINT, ...;
         SQLite says what the column is declared with: INTEGER, VARCHAR, ...

         To see which names your database gives, empty the type-map: <type-map default=""/>
         and generate. The code then has the raw names of the driver instead of Go types.
         unknown - the driver said nothing about the type (MySQL parameters, SQLite expressions).

         A class is generated for database/sql, sqlx or gorm by its name in sdm.xml:
            <dto-class name="Task" ...>       - the keys without prefix
            <dto-class name="sqlx-Task" ...>  - the keys with "sqlx-"
            <dto-class name="gorm-Task" ...>  - the keys with "gorm-" ("+auto" - auto="..." column)
         The data store in the DAO folder has to match: sdmc init -orm no_orm, sqlx or gorm.
         The sets you don't use can be removed or commented out. -->

{{type-map}}

    <macros>

        <macro value="=built-in=" name="${column}"/>
        <macro value="=built-in=" name="${lower_snake_case(column)}"/>
        <macro value="=built-in=" name="${camelCase(column)}"/>
        <macro value="=built-in=" name="${TitleCase(column)}"/>
        <macro value="=built-in=" name="${kebab-case(column)}"/>

        <macro name="${json-col}" value="${lower_snake_case(column)}"/>

        <macro name="${json}" value=" `json:&quot;${json-col}${0}&quot;`"/>

        <macro name="${json-sqlx}" value=" `json:&quot;${json-col}${0}&quot; db:&quot;${column}&quot;`"/>

        <macro name="${json-gorm}"
               value=" `json:&quot;${json-col}${0}&quot; gorm:&quot;column:${column}${gorm-params}${1}&quot;`"/>

        <macro name="${json-gorm-time}" value="time:time.Time${json-gorm} -> SetTime"/>

        <!-- gorm tag parameters from the metadata of the column -->
        <macro name="${gorm-params}">
            <vm-xml>
                <if var="$fi.ColumnSize > 0">
                    <print var=";size:$fi.ColumnSize"/>
                </if>
                <if var="$fi.PK">
                    <print var=";primaryKey"/>
                    <if var="$fi.AI">
                        <print var=";autoIncrement"/>
                    </if>
                    <else>
                        <if var="$fi.Unique &amp;&amp; $fi.Indexed">
                            <print var=";uniqueIndex"/>
                            <else>
                                <if var="$fi.Unique">
                                    <print var=";unique"/>
                                </if>
                                <if var="$fi.Indexed">
                                    <print var=";index"/>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
                <if var="!$fi.Nullable">
                    <print var=";not null"/>
                </if>
            </vm-xml>
        </macro>

    </macros>

</settings>
