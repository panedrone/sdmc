<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="settings.xsd">

    <!-- Migrated from "sdm/settings.xml" of "D:/work/sdm-cpp/qt6_sqlite3_task_board".
         Same values, current attribute names: "<type java=" -> "<type detected=",
         "<external-vm-file>" and "<cpp class-prefix>" are gone, "macro" and
         "field-assign-mode" are now required. "jar", "url" and "sql" are still
         relative to the project dir, i.e. to the demo project, not to this folder. -->

    <folders target="" sql="sdm/sql"/>

    <dto scope="" inheritance="" field-names-mode="0" macro=""/>

    <dao scope="" field-assign-mode="0" macro=""/>

    <ide event-log="true"/>

    <jdbc jar="sdm/sqlite-jdbc-3.32.3.2.jar" class="org.sqlite.JDBC"
          url="jdbc:sqlite:$PROJECT_DIR$/task_tracker.sqlite" user="" pwd=""/>

    <type-map default="CVariant">
        <type detected="INTEGER" target="${nullable}|0:qint64|1:CInt64N"/>
        <type detected="BIGINT" target="${nullable}|0:qint64|1:CInt64N"/>
        <type detected="BOOLEAN" target="${nullable}|0:qint64|1:CInt64N"/>
        <type detected="DATE" target="${nullable}|0:QString|1:CTextN"/>
        <type detected="STRING" target="${nullable}|0:QString|1:CTextN"/>
        <type detected="TEXT" target="${nullable}|0:QString|1:CTextN"/>
    </type-map>

    <macros>
        <macro name="${nullable}">
            <vm-xml>
                <if var="$fi.Nullable &amp;&amp; !$fi.PK">
                    <print var="${1}"/>
                    <else>
                        <print var="${0}"/>
                    </else>
                </if>
            </vm-xml>
        </macro>
    </macros>

</settings>
